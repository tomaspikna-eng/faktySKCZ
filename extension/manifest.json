{
  "manifest_version": 3,
  "name": "DETEKTOR",
  "version": "0.7.3",
  "description": "DETEKTOR — Live CZ/SK fact-checking v bočnom paneli.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabCapture",
    "offscreen",
    "sidePanel",
    "tabs"
  ],
  "action": {
    "default_title": "DETEKTOR",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "https://mexrrchqiehzvrefftym.supabase.co/*"
  ],
  "commands": {
    "open-summary": {
      "description": "Otvoriť sidebar – Prehľad"
    },
    "open-facts": {
      "description": "Otvoriť sidebar – Tvrdenia"
    },
    "open-disputed": {
      "description": "Otvoriť sidebar – Sporné"
    },
    "open-patterns": {
      "description": "Otvoriť sidebar – Vzorce"
    },
    "open-actors": {
      "description": "Otvoriť sidebar – Aktéri"
    }
  },
  "short_name": "DETEKTOR",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}