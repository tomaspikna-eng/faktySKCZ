{
  "manifest_version": 3,
  "name": "DETEKTOR — Live Fact Check",
  "version": "0.6.6",
  "description": "DETEKTOR — Live CZ/SK fact-checking z audia aktuálneho tabu v bočnom paneli.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabCapture",
    "offscreen",
    "sidePanel",
    "tabs"
  ],
  "action": {
    "default_title": "Otvoriť DETEKTOR"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "https://mexrrchqiehzvrefftym.supabase.co/*"
  ],
  "commands": {
    "open-summary": {
      "description": "Otvoriť sidebar – Prehľad"
    },
    "open-facts": {
      "description": "Otvoriť sidebar – Tvrdenia"
    },
    "open-disputed": {
      "description": "Otvoriť sidebar – Sporné"
    },
    "open-patterns": {
      "description": "Otvoriť sidebar – Vzorce"
    },
    "open-actors": {
      "description": "Otvoriť sidebar – Aktéri"
    }
  }
}
